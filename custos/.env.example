# ---------------------------------------------------------------------------
# CUSTOS — .env.example (copy to .env.local and fill in)
# Never commit real secrets. Tokens and secrets live ONLY in env vars.
# ---------------------------------------------------------------------------

# Database (production = Postgres; unset in dev = on-disk PGlite at ./.pglite)
DATABASE_URL=

# Session signing secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# Messaging mode: "simulator" (default, always works) | "whatsapp" (Meta Cloud API)
MESSAGING_MODE=simulator

# Cron guard for /api/cron/agent (Vercel Cron sends it as "Authorization: Bearer").
# Leave empty in local dev (route runs open); ALWAYS set in production.
CRON_SECRET=

# Media bytes are stored under the OS temp dir by default (Vercel-safe: only
# /tmp is writable). For a persistent volume set this to a writable path.
CUSTOS_MEDIA_DIR=

# --- WhatsApp Cloud API (M7) — leave empty until then ------------------------
WA_BUSINESS_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=
WA_GRAPH_API_BASE=https://graph.facebook.com
