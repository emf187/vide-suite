# ------------------------------------------------------------------
# Cogitex Maintenance Planner - environment template (names only)
# Copy to .env.local for local dev, set in Vercel dashboard for deploy.
# ------------------------------------------------------------------

# PostgreSQL connection string.
# For the Vercel demo: create a free database at https://neon.tech and paste its
# pooled connection string here (also set it in Vercel -> Settings -> Environment Variables).
# When unset and NODE_ENV=development, the app runs on an in-process PGlite database
# (data resets on every restart - dev convenience only, never used in production).
DATABASE_URL=

# Secret used to sign session cookies (HS256). Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- Integration layer (INTEGRATION_CONTRACTS.md) - all optional; mocks are default ---
# VIDE live machine health / energy / fault service
VIDE_API_BASE_URL=
VIDE_INTEGRATION_BASE_URL=
VIDE_WEBHOOK_SECRET=
VIDE_HMAC_HEADER=X-Cogitex-Signature
VIDE_TIMESTAMP_HEADER=X-Cogitex-Timestamp
CORTEX_API_BASE_URL=
CORTEX_API_KEY=

# Verified Technician marketplace
MARKETPLACE_API_BASE_URL=
MARKETPLACE_API_KEY=
MARKETPLACE_WEBHOOK_SECRET=

# Shared services
IDENTITY_SERVICE_URL=
NOTIFICATION_SERVICE_URL=

# Maintenance agent LLM gateway
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Uploads
UPLOAD_STORAGE_BACKEND=
UPLOAD_SCANNER_HOOK_URL=

# Force a specific integration profile in dev ("mock" | "real"); default: mock
INTEGRATION_PROFILE=

# --- SUITE SSO (one login across VIDE CORTEX + Cogitex) ---
# Same shared secret as VIDE (identical value in both apps).
AUTH_SECRET=
# Public URL of THIS app as deployed (used to build SSO exchange URLs)
COGITEX_PUBLIC_URL=https://<your-cogitex-app>.vercel.app
# VIDE console login page - stranded visitors continue sign-in there
VIDE_LOGIN_URL=https://<your-vide-app>.vercel.app/login
# Which hosts may run the SSO exchange (comma-separated, no protocol)
VIDE_SSO_ALLOWED_HOSTS=<your-vide-app>.vercel.app
# Open the VIDE console from the planner sidebar/topbar
NEXT_PUBLIC_SUITE_COAPP_URL=https://<your-vide-app>.vercel.app
