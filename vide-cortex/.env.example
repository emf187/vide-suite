# Copy to .env.local and adjust.

# Backend base URL used when the operator has not saved one yet (localStorage "vide_backend_url").
NEXT_PUBLIC_DEFAULT_API_URL=http://127.0.0.1:8000/api

# true = serve a built-in fake fleet so every page works without the backend.
# Operators can also flip this at runtime from the SOURCE panel in the top bar.
NEXT_PUBLIC_USE_MOCKS=true

# Optional: proxy /api/* to the backend (see next.config.ts). If set, use NEXT_PUBLIC_DEFAULT_API_URL=/api
# API_PROXY_TARGET=http://127.0.0.1:8000

# --- SUITE SSO (one login across VIDE CORTEX + Cogitex) ---
# Shared session secret - MUST be the same value in both apps. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Cogitex machine-to-machine endpoints (VDIE verifies passwords / provisions accounts there)
COGITEX_VERIFY_URL=https://<your-cogitex-app>.vercel.app/api/auth/suite-verify
COGITEX_PROVISION_URL=https://<your-cogitex-app>.vercel.app/api/auth/suite-provision
# Deep link the Cogitex sidebar/topbar uses to open the planner
NEXT_PUBLIC_SUITE_COAPP_URL=https://<your-cogitex-app>.vercel.app
